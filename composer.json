{
  "name": "ankitrawat/local-seo-by-ankit-rawat",
  "description": "LocalBusiness JSON-LD and optional WooCommerce product structured data for WordPress.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpstan/phpstan": "^1.12"
  },
  "autoload": {
    "psr-4": {
      "AnkitRawat\\LocalSEO\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "test": "phpunit -c phpunit.xml.dist",
    "phpcs": "phpcs",
    "phpstan": "phpstan analyse -c phpstan.neon.dist --memory-limit=512M"
  }
}
